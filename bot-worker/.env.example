# Wingman notetaker bot worker — copy to .env and fill in.

# Where the Wingman backend lives (no trailing slash).
BACKEND_URL=https://imyourwingman.ai

# Shared secret. MUST be identical to BOT_WORKER_TOKEN in the backend's .env,
# or the backend returns 401/503 and the bot never gets jobs.
BOT_WORKER_TOKEN=change-me-to-a-long-random-string

# How often to poll the backend for queued meetings (ms).
POLL_INTERVAL_MS=20000

# Safety cap: leave the call after this many minutes no matter what.
MAX_MEETING_MIN=150

# How long to wait in the lobby for the host to admit the bot (ms).
ADMIT_TIMEOUT_MS=300000

# Display name the bot shows in the call.
# (Set BOT_NAME on the BACKEND instead — it's stored per session. This is only a
#  fallback for URLs joined outside the backend.)

# OPTIONAL — for Meet meetings that block anonymous guests: a Playwright
# storageState JSON with a signed-in Google account. See README.
# STORAGE_STATE=/app/google-state.json
